{
  "name": "md2html",
  "version": "1.0.0",
  "description": "Markdown-to-HTML static site generator with minimal black/white design system",
  "main": "build.js",
  "scripts": {
    "build": "node build.js",
    "clean": "node -e \"const fs=require('fs');fs.rmSync('dist',{recursive:true,force:true});console.log('dist/ cleaned')\""
  },
  "dependencies": {
    "marked": "^12.0.0",
    "gray-matter": "^4.0.3",
    "js-yaml": "^4.1.0"
  },
  "keywords": ["markdown", "static-site-generator", "documentation"],
  "license": "MIT"
}
